# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# environments
.venv/

# experiment outputs (artifacts are archived, not committed; keep dir via .gitkeep)
experiments/*
!experiments/.gitkeep

# dataset cache
*.parquet
data/cache/
data/external/

# reference PDFs live in papers/ — kept local, never committed to GitHub
*.pdf

# pycox early-stopping weight checkpoints (written to cwd during DeepHit/DeepSurv fits)
weight_checkpoint_*.pt

# auto-generated simulation cell configs (regenerate with write_default_configs)
configs/sim/*.yaml
!configs/sim/.gitkeep

# editor / OS
.DS_Store
.vscode/
.idea/

# secrets / local env
.env
.env.local

# downloaded or serialized data artifacts
*.h5
*.pkl
*.ckpt

# local assistant context — kept local, not committed
AGENTS.md
